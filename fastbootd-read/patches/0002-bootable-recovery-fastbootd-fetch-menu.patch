@@ -29,6 +29,41 @@
 
 #include "recovery_ui/ui.h"
 
+#include <android-base/file.h>
+
+namespace {
+
+// Keep this path in sync with FASTBOOTD_FETCH_POLICY_PATH in
+// system/core/fastboot/device/fetch_policy.h. The fastbootd daemon is a
+// separate process that reads this tmpfs file before every `fetch`; writing it
+// from this on-screen menu is the only way to widen partition reading, and
+// nothing reachable over USB can change it.
+constexpr char kFetchPolicyPath[] = "/dev/fastbootd_fetch_policy";
+constexpr int kFetchReadAll = 1;       // "Enable reading"
+constexpr int kFetchUnrestricted = 2;  // "Enable all partitions"
+
+// Show a confirmation screen; only on an explicit yes, widen the fetch policy.
+// Reading is always read only: this never enables any write, flash or erase.
+void ConfirmAndEnableFetch(Device* device, int policy,
+                           const std::vector<std::string>& warning) {
+  RecoveryUI* ui = device->GetUI();
+  std::vector<std::string> items{ "Cancel", "Yes, enable reading" };
+  size_t chosen = ui->ShowMenu(
+      warning, items, 0 /* default to Cancel */, true /* menu_only */,
+      std::bind(&Device::HandleMenuKey, device, std::placeholders::_1, std::placeholders::_2));
+  if (chosen != 1) {
+    ui->Print("fastbootd: left partition reading disabled.\n");
+    return;
+  }
+  if (android::base::WriteStringToFile(std::to_string(policy), kFetchPolicyPath)) {
+    ui->Print("fastbootd: partition reading enabled (policy %d). Read only.\n", policy);
+  } else {
+    ui->Print("fastbootd: FAILED to enable partition reading.\n");
+  }
+}
+
+}  // namespace
+
 static const std::vector<std::pair<std::string, Device::BuiltinAction>> kFastbootMenuActions{
   { "Reboot system now", Device::REBOOT_FROM_FASTBOOT },
   { "Enter recovery", Device::ENTER_RECOVERY },
@@ -87,20 +122,52 @@ Device::BuiltinAction StartFastboot(Device* device, const std::vector<std::strin
     LOG(ERROR) << "Failed to clear BCB message: " << err;
   }
 
